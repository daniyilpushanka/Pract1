import math

def calculate(x, y):
    return (math.sqrt(x) + y ** 2) / 3

def sport():
    distance = 10
    total = 0
    days = 0

    while total < 50:
        total = total + distance
        days = days + 1
        distance = distance * 1.1

    print()
    print("Кількість днів:", days)
    print("Загальна відстань:", total)


while True:

    print()
    print("1 - Обчислити значення виразу")
    print()
    print("2 - Визначити кількість днів")
    print()

    choice = int(input("Виберіть функцію: "))

    if choice == 1:
        print()

        x = float(input("Введіть x: "))
        y = float(input("Введіть y: "))

        result = calculate(x, y)

        print()
        print("Результат:", result)

    elif choice == 2:
        print()

        sport()

    else:
        print()
        print("Неправильний вибір")

    input("Натисніть Enter, щоб повернутися до меню")
